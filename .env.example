# הערה לפריסה ב-Streamlit Community Cloud: משתני הסביבה האלה לא נטענים שם
# אוטומטית מקובץ .env - יש להדביק אותם (באותם שמות, כערכי TOML) תחת
# Settings -> Secrets באתר הפריסה. config.py קורא קודם מ-st.secrets ורק
# אם זה לא קיים נופל למשתני סביבה/.env, כך שאותו קוד עובד בשני המקומות.

# העתיקו קובץ זה ל-.env ומלאו ערכים אמיתיים. אל תעלו .env ל-Git.

# --- Apify (סריקת Booking / Airbnb / Expedia) ---
APIFY_API_TOKEN=
# אופציונלי - אם ריק, נעשה שימוש ב-voyager/booking-scraper, tri_angle/airbnb-scraper,
# parseforge/expedia-scraper
APIFY_BOOKING_ACTOR_ID=
APIFY_AIRBNB_ACTOR_ID=
APIFY_EXPEDIA_ACTOR_ID=

# --- RapidAPI (גיבוי אופציונלי, לא בשימוש כרגע בקוד) ---
RAPIDAPI_KEY=

# --- השלמה אוטומטית של יעדים ---
# הרשמה חינמית: https://www.geonames.org/login -> לאחר ההרשמה יש להפעיל
# "free web services" בעמוד ה-Account. בלי זה, האפליקציה תיפול אוטומטית
# ל-Nominatim (עדיין עובד, אבל מכסה פחות ישובים קטנים).
GEONAMES_USERNAME=

# --- משקלי אלגוריתם הדירוג במצב "מיטבי" (אופציונלי - למצבי זול/איכותי יש פרסטים קבועים) ---
WEIGHT_PRICE=0.45
WEIGHT_RATING=0.40
WEIGHT_REVIEW_COUNT=0.15

# תיקון סטטיסטי לציון ביקורות מועטות (ראו הסבר ב-ranking.py)
RATING_PRIOR=8.0
RATING_CONFIDENCE=20

# כמות תוצאות מקסימלית לבקש מכל מקור סריקה (משפיע על עלות/זמן ריצה)
MAX_RESULTS_PER_SOURCE=30

# כמות פריטי היסטוריה מקסימלית להצגה בסרגל הצד
HISTORY_DISPLAY_LIMIT=15
